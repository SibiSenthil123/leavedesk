# Copy this file to .env and change the values. Never commit .env.
# Make a secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LEAVEDESK_JWT_SECRET=change-me-to-a-long-random-string-of-48-characters
LEAVEDESK_ACCESS_TOKEN_MINUTES=30
# Demo users (meera, arjun, priya, kiran @leavedesk.dev) all log in with this password.
LEAVEDESK_SEED_DEMO_DATA=true
LEAVEDESK_DEMO_PASSWORD=leavedesk-demo-2026
LEAVEDESK_LOG_LEVEL=INFO
